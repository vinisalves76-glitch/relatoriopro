rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isMaster(){return signedIn() && request.auth.uid == 'sQYjYwjn2vOKtXty7NOT9CO43Mk1';}
  function profileExists(uid){return exists(/databases/$(database)/documents/userProfiles/$(uid));}
  function profile(uid){return get(/databases/$(database)/documents/userProfiles/$(uid)).data;}
  function isSystemAdmin(){return isMaster() || (signedIn() && profileExists(request.auth.uid) && profile(request.auth.uid).active == true && profile(request.auth.uid).role in ['auxiliar_administrativo','gerente','coordenador']);}
  function hasPermission(permission){return signedIn() && profileExists(request.auth.uid) && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true && permission in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions;}
  match /userProfiles/{userId}{allow read:if signedIn()&&(request.auth.uid==userId||isMaster()||isSystemAdmin());allow create:if isMaster() || (isSystemAdmin() && request.resource.data.role in ['instrutor_tecnico','consultor_tecnico']);allow update,delete:if isMaster()&&userId!='sQYjYwjn2vOKtXty7NOT9CO43Mk1';}
  match /users/{userId}/reports/{reportId}{
   allow read:if isSystemAdmin()||(signedIn()&&request.auth.uid==userId&&hasPermission('reports.view'));
   allow create:if isMaster()||(signedIn()&&request.auth.uid==userId&&hasPermission('reports.create'));
   allow update:if isMaster()||(signedIn()&&request.auth.uid==userId&&hasPermission('reports.edit'));
   allow delete:if isMaster()||(signedIn()&&request.auth.uid==userId&&hasPermission('reports.delete'));
   match /photos/{photoId}{allow read:if isSystemAdmin()||(signedIn()&&request.auth.uid==userId&&hasPermission('reports.view'));allow create,update:if isMaster()||(signedIn()&&request.auth.uid==userId&&(hasPermission('reports.create')||hasPermission('reports.edit')));allow delete:if isMaster()||(signedIn()&&request.auth.uid==userId&&hasPermission('reports.delete'));}
  }
  match /users/{userId}/settings/{settingId}{allow read:if isMaster()||(signedIn()&&request.auth.uid==userId&&(hasPermission('model.view')||hasPermission('model.edit')));allow create,update,delete:if isMaster()||(signedIn()&&request.auth.uid==userId&&hasPermission('model.edit'));}
 }
}